# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public URL of this install (used for invite and registration links)
BASE_URL=https://badgecraft.example.com

# Optional: extra comma-separated origins allowed to call the API
ALLOWED_ORIGINS=

# Google OAuth (optional) — authorised redirect URI: <BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for email invites (optional — invite links work without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
