# Generate a strong random key: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Your domain
BASE_URL=https://badgecraft.example.com

# Google OAuth — create at https://console.cloud.google.com
# Authorised redirect URI: https://badgecraft.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for email invites (optional — invite links work without this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@badgecraft.example.com
